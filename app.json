{
  "expo": {
    "name": "AIGMA PTE",
    "slug": "aigma-pte",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aigmapte.mobile"
    },
    "android": {
      "package": "com.aigmapte.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#123A70"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7FC"
        }
      ]
    ]
  }
}
